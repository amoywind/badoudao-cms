{
  "name": "badoudao-cms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx @cloudflare/next-on-pages",
    "preview": "node preview/render.js && node preview/serve.js",
    "deploy": "npm run build && npx wrangler pages deploy .vercel/output/static",
    "db:migrate:local": "wrangler d1 migrations apply badoudao --local",
    "db:migrate:remote": "wrangler d1 migrations apply badoudao --remote",
    "db:seed:remote": "wrangler d1 execute badoudao --remote --file=./seed.sql",
    "db:studio": "wrangler d1 studio badoudao",
    "preview:build": "node preview/render.js",
    "preview:serve": "node preview/serve.js",
    "db:export:local": "wrangler d1 execute badoudao --local --config wrangler.local.toml --file=./seed.sql && wrangler d1 execute badoudao --local --config wrangler.local.toml --command \"SELECT * FROM categories\" --json > preview/data/categories.json"
  },
  "dependencies": {
    "next": "15.5.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "wrangler": "^3.114.14",
    "typescript": "^5.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
