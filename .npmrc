# Cloudflare builds on Linux, local development here runs on Windows.
#
# fsevents is a macOS-only optional dependency of chokidar (Next.js file
# watching). npm skips it on Windows, so package-lock.json never records it —
# but Cloudflare's Linux build environment expects it and `npm ci` then fails
# with "Missing: fsevents@2.3.3 from lock file".
#
# `--include=optional` makes npm record optional dependencies for every
# platform in the lock file, keeping `npm ci` happy everywhere.
include=optional